{
  "name": "@petlord/desktop",
  "version": "0.1.13",
  "description": "Integrated PetLord desktop pet runtime and design Studio",
  "author": "PetLord contributors",
  "license": "MIT",
  "private": true,
  "productName": "PetLord",
  "desktopName": "petlord",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "electron": "electron electron/main.cjs",
    "build:renderer": "tsc --noEmit && vite build && node --check electron/application-menu.cjs && node --check electron/main.cjs && node --check electron/package-store.cjs && node --check electron/preload.cjs && node --check electron/studio-host.cjs && node --check electron/studio-preload.cjs",
    "build:resources": "node scripts/build-resources.mjs",
    "build": "npm run build:renderer && npm run build:resources",
    "dist:dir": "node scripts/package.mjs dir",
    "dist:mac": "node scripts/package.mjs mac-arm64",
    "dist:mac:arm64": "npm run dist:mac",
    "dist:mac:universal": "node scripts/package.mjs mac-universal",
    "dist:linux": "npm run dist:linux:x64",
    "dist:linux:x64": "node scripts/package.mjs linux-x64",
    "dist:win": "npm run dist:win:x64",
    "dist:win:x64": "node scripts/package.mjs win-x64"
  },
  "dependencies": {
    "@petlord/plugin-agent-activity": "*",
    "@petlord/plugin-sdk": "*",
    "@petlord/plugin-todo": "*",
    "@petlord/runtime-core": "*",
    "@petlord/runtime-react": "*",
    "@petlord/schema": "*",
    "@petlord/state-engine": "*",
    "@phosphor-icons/react": "latest",
    "@radix-ui/react-dialog": "^1.1.23",
    "react": "latest",
    "react-dom": "latest",
    "@petlord/ui": "*",
    "antd": "^6.6.2"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "vite": "latest"
  },
  "build": {
    "appId": "com.petlord.desktop",
    "productName": "PetLord",
    "artifactName": "PetLord-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/**/*",
      "service/**/*",
      "studio/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/${arch}",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "PetLord ${version}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "petlord",
      "maintainer": "PetLord contributors",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "PetLord-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis",
      "artifactName": "PetLord-Setup-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
